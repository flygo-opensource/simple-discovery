{
  "name": "@simple-discovery/core",
  "version": "3.0.0",
  "description": "Shared contract, signed packet format and broker base class for simple-discovery transports",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/simple-discovery.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/flygo-opensource/simple-discovery/tree/main/packages/core#readme",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "files": [
    "build/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "test": "bun test tests/*.test.ts"
  },
  "dependencies": {
    "msgpackr": "^1.12.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Duong Van Ba",
  "publishConfig": {
    "access": "public"
  }
}
