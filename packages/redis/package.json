{
  "name": "@simple-discovery/redis",
  "version": "3.0.0",
  "description": "Service discovery over Redis pub/sub with the simple-discovery signed envelope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/simple-discovery.git",
    "directory": "packages/redis"
  },
  "homepage": "https://github.com/flygo-opensource/simple-discovery/tree/main/packages/redis#readme",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "files": [
    "build/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "test": "bun test tests/*.test.ts"
  },
  "dependencies": {
    "@simple-discovery/core": "workspace:^",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Duong Van Ba",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "discovery",
    "service-discovery",
    "redis"
  ]
}
