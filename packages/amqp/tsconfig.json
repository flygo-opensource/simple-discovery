{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "build",
    "rootDir": "src",
    "types": ["node", "bun"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["build", "node_modules", "tests"]
}
