{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "build",
    "types": [
      "node",
      "bun"
    ],
    "skipLibCheck": true,
    "paths": {
      "@simple-discovery/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "build",
    "node_modules",
    "tests"
  ]
}
